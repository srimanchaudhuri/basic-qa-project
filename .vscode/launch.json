{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug FastAPI",
			"type": "debugpy",
			"request": "launch",
			"module": "uvicorn",
			"args": [
				"app.main:app",
				"--host",
				"0.0.0.0",
				"--port",
				"3000"
			],
			"cwd": "${workspaceFolder}",
			"envFile": "${workspaceFolder}/.env",
			"console": "integratedTerminal",
			"justMyCode": true
		}
	]
}
